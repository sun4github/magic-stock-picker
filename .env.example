# Financial Modeling Prep API key — screener universe, fundamentals, analyst
# consensus, and news. Requires a Starter plan or higher (some endpoints used
# here, like stable/key-metrics, ratios, market-capitalization, aren't on the
# free tier).
FMP_API_KEY=YOUR_FMP_API_KEY_HERE

# Tavily API key — web search used by the Bear/Bull/Sale Advisor agents to
# research current news. Pay-as-you-go recommended for production use.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# PostgreSQL connection string. The database must have the pgvector extension
# enabled (CREATE EXTENSION vector;). Used to persist pipeline runs, each
# agent's output, and the final reports.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Descriptive User-Agent required by SEC EDGAR for 10-K/10-Q data requests.
# Format: "Your Name your.email@example.com"
SEC_USER_AGENT="Your Name your.email@example.com"

# Google AI (Gemini) API key — powers the Bear, Bull, Analyst, and Sale
# Advisor LLM agents. A paid/upgraded key is strongly recommended; the free
# tier's daily quota (20 requests/day) is exhausted in a single run.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# ---------------------------------------------------------------------------
# OPTIONAL — only needed to serve the MCP layer (agent_mcp/) over the network.
# Leave unset for the CLI, or for an MCP client running on this machine over
# stdio, which needs no token because it is a pipe rather than a socket.
# ---------------------------------------------------------------------------

# Shared secret an MCP client must present as `Authorization: Bearer <value>`.
# It is NOT issued by any service — you invent it, and the same string goes in
# the client's config. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# The server REFUSES to bind a non-loopback address without it, because these
# tools spend real money and reach the database. Rotate it by changing this line
# and the client's config together, then restarting the server.
# MSP_MCP_TOKEN=
